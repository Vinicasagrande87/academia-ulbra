PORT=3000

# String de conexão do PostgreSQL (ex: projeto gratuito no Supabase)
DATABASE_URL=postgresql://usuario:senha@host:5432/nome_do_banco

# Gere uma string aleatória grande — nunca reaproveite entre projetos/clientes
APP_SECRET=troque_por_uma_string_aleatoria_grande

# URL(s) do front autorizadas no CORS, separadas por vírgula
FRONT_URL=http://localhost:8100

# Credenciais do serviço de e-mail usado no cadastro do aluno
EMAIL_USER=
EMAIL_PASS=

# Chave da API do WorkoutX (https://workoutxapp.com/) — opcional, só necessária
# pra buscar/vincular gifs de exercícios
WORKOUTX_API_KEY=
