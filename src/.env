# ------------------------------------------------------------------------------
# CONFIGURAÇÕES DO SERVIDOR
# ------------------------------------------------------------------------------
# Porta onde a API da academia será executada
PORT=3000

# Define o ambiente de execução (development ou production)
NODE_ENV=development

# ------------------------------------------------------------------------------
# BANCO DE DADOS POSTGRESQL (ONLINE)
# ------------------------------------------------------------------------------
# Substitua pelo link real fornecido pelo seu host de banco de dados
# O formato geralmente é: postgres://usuario:senha@host:porta/nome_do_banco
DATABASE_URL=postgres://usuario:senha@host:5432/nome_do_banco

# ------------------------------------------------------------------------------
# SEGURANÇA E AUTENTICAÇÃO
# ------------------------------------------------------------------------------
# Chave secreta para gerar os tokens de acesso (JWT) para alunos e professores
JWT_SECRET=sua_chave_secreta_super_segura_aqui

# Tempo de expiração do login (exemplo: 7 dias)
JWT_EXPIRES_IN=7d

# ------------------------------------------------------------------------------
# CONFIGURAÇÕES DE E-MAIL (OPCIONAL)
# ------------------------------------------------------------------------------
# Útil para enviar alertas de mensalidade ou recuperação de senha
MAIL_HOST=smtp.exemplo.com
MAIL_PORT=587
MAIL_USER=seu_email@exemplo.com
MAIL_PASS=sua_senha_de_email